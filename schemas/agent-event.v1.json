{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "description": "Which agent instance and conversation the event belongs to.",
      "properties": {
        "type": {
          "$ref": "#/$defs/AgentType"
        },
        "session_id": {
          "description": "Agent-native session/conversation id",
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One agent turn/run inside the session, if known",
          "title": "Run Id"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        }
      },
      "required": [
        "type",
        "session_id"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "AgentType": {
      "description": "The AI agent product that produced the activity.",
      "enum": [
        "openclaw",
        "claude_code",
        "langgraph",
        "gemini_cli",
        "codex_cli",
        "unknown"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "AssistantMessage": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "message.assistant",
          "default": "message.assistant",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "AssistantMessage",
      "type": "object"
    },
    "ComponentIntegrity": {
      "additionalProperties": false,
      "description": "One installed unit of agent code compared with what its publisher signed.",
      "properties": {
        "component": {
          "description": "\"core\" or \"plugin:<id>\"",
          "title": "Component",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "npm package expected to contain it, e.g. \"openclaw\"",
          "title": "Package"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "openclaw: core | bundled | global | config | workspace",
          "title": "Origin"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Installed directory that was hashed",
          "title": "Path"
        },
        "digest": {
          "description": "integrity.tree_digest of the installed files",
          "title": "Digest",
          "type": "string"
        },
        "integrity": {
          "description": "verified: matches a signed package; mismatch: differs from it (tampered); pending: no verified digests for this version yet; unknown: no package or pin vouches for it",
          "enum": [
            "verified",
            "mismatch",
            "pending",
            "unknown"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "trust": {
          "default": "unverified",
          "description": "Status of the package version it belongs to (policy manifests)",
          "enum": [
            "approved",
            "trusted",
            "cooling",
            "revoked",
            "rejected",
            "unverified"
          ],
          "title": "Trust",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "digest",
        "integrity"
      ],
      "title": "ComponentIntegrity",
      "type": "object"
    },
    "ConfigSnapshot": {
      "additionalProperties": false,
      "description": "Security-relevant settings of an agent installation, read from its own config.\n\nOnly allowlisted fields are copied: the config file also holds tokens and account details,\nwhich never leave the endpoint. Emitted at sensor start and whenever these fields change.",
      "properties": {
        "kind": {
          "const": "config.snapshot",
          "default": "config.snapshot",
          "title": "Kind",
          "type": "string"
        },
        "product": {
          "description": "e.g. openclaw",
          "title": "Product",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Config file the values came from",
          "title": "Path"
        },
        "changed": {
          "default": [],
          "description": "Fields that differ from the previous snapshot",
          "items": {
            "type": "string"
          },
          "title": "Changed",
          "type": "array"
        },
        "guard_plugin": {
          "anyOf": [
            {
              "enum": [
                "enabled",
                "disabled",
                "missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The SG-Advance enforcement plugin as the config leaves it",
          "title": "Guard Plugin"
        },
        "guard_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guard Detail"
        },
        "plugins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginDescriptor"
          },
          "title": "Plugins",
          "type": "array"
        },
        "exec_policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExecPolicy"
          },
          "title": "Exec Policies",
          "type": "array"
        },
        "runtimes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimePin"
          },
          "title": "Runtimes",
          "type": "array"
        }
      },
      "required": [
        "product"
      ],
      "title": "ConfigSnapshot",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "description": "The machine (container / VM / PC) the agent runs on.",
      "properties": {
        "device_id": {
          "description": "Stable id issued at enrollment",
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "hostname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os"
        },
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "ExecPolicy": {
      "additionalProperties": false,
      "description": "Shell-execution policy at one scope. ``None`` means \"not set here\" (the agent's default).",
      "properties": {
        "scope": {
          "description": "\"global\" or \"agent:<id>\"",
          "title": "Scope",
          "type": "string"
        },
        "security": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "openclaw: deny | allowlist | full",
          "title": "Security"
        },
        "ask": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "openclaw: off | on-miss | always",
          "title": "Ask"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "openclaw: deny | allowlist | ask | auto | full",
          "title": "Mode"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "elevated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Privileged command path enabled",
          "title": "Elevated"
        }
      },
      "required": [
        "scope"
      ],
      "title": "ExecPolicy",
      "type": "object"
    },
    "IntegrityReport": {
      "additionalProperties": false,
      "description": "Installed agent code vs. known-good digests from the policy. Sent when anything changes.",
      "properties": {
        "kind": {
          "const": "integrity.report",
          "default": "integrity.report",
          "title": "Kind",
          "type": "string"
        },
        "product": {
          "description": "e.g. openclaw",
          "title": "Product",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "core": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentIntegrity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plugins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ComponentIntegrity"
          },
          "title": "Plugins",
          "type": "array"
        }
      },
      "required": [
        "product"
      ],
      "title": "IntegrityReport",
      "type": "object"
    },
    "InventorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inventory.snapshot",
          "default": "inventory.snapshot",
          "title": "Kind",
          "type": "string"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolDescriptor"
          },
          "title": "Tools",
          "type": "array"
        },
        "plugins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginDescriptor"
          },
          "title": "Plugins",
          "type": "array"
        },
        "mcp_servers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mcp Servers",
          "type": "array"
        }
      },
      "title": "InventorySnapshot",
      "type": "object"
    },
    "LlmCall": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "llm.call",
          "default": "llm.call",
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "description": "anthropic | openai | google | ollama | ...",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "LlmCall",
      "type": "object"
    },
    "NetEgress": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "net.egress",
          "default": "net.egress",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "bytes_out": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Out"
        },
        "destination": {
          "default": "unknown",
          "enum": [
            "internal",
            "external",
            "unknown"
          ],
          "title": "Destination",
          "type": "string"
        }
      },
      "required": [
        "url",
        "host"
      ],
      "title": "NetEgress",
      "type": "object"
    },
    "PluginDescriptor": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Install source: registry, path, git url ...",
          "title": "Source"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "plugin_id"
      ],
      "title": "PluginDescriptor",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "The human the agent acts on behalf of.",
      "properties": {
        "user_id": {
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "user_id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "RuntimePin": {
      "additionalProperties": false,
      "description": "Which runtime executes a model's turns. Tools that run inside a foreign runtime (e.g. a CLI\nbackend) may never pass the gateway's pre-execution hooks.",
      "properties": {
        "scope": {
          "description": "\"defaults\" or \"agent:<id>\"",
          "title": "Scope",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "runtime": {
          "description": "Pinned runtime id, or \"default\" when nothing pins it",
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "model",
        "runtime"
      ],
      "title": "RuntimePin",
      "type": "object"
    },
    "SensorHealth": {
      "additionalProperties": false,
      "description": "State of an enforcement or observation component, reported by the sensor itself.\nA component that goes quiet (e.g. a gateway plugin that stopped sending heartbeats) is a\ncontrol gap: tool calls may now run without a pre-execution check.",
      "properties": {
        "kind": {
          "const": "sensor.health",
          "default": "sensor.health",
          "title": "Kind",
          "type": "string"
        },
        "component": {
          "description": "e.g. openclaw_plugin",
          "title": "Component",
          "type": "string"
        },
        "status": {
          "enum": [
            "up",
            "lost",
            "recovered"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "last_seen": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last sign of life before this report",
          "title": "Last Seen"
        }
      },
      "required": [
        "component",
        "status"
      ],
      "title": "SensorHealth",
      "type": "object"
    },
    "SensorType": {
      "description": "How the activity was observed. One agent can be seen by several sensors\n(e.g. Claude Code via its hooks *and* via the MCP proxy).",
      "enum": [
        "openclaw_gateway",
        "openclaw_plugin",
        "openclaw_config",
        "openclaw_integrity",
        "claude_code_hook",
        "gemini_cli_hook",
        "codex_cli_hook",
        "langgraph_callback",
        "mcp_proxy",
        "llm_proxy",
        "egress_proxy"
      ],
      "title": "SensorType",
      "type": "string"
    },
    "SessionEnd": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "session.end",
          "default": "session.end",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "completed | aborted | error | ...",
          "title": "Reason"
        }
      },
      "title": "SessionEnd",
      "type": "object"
    },
    "SessionStart": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "session.start",
          "default": "session.start",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "permission_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent-native approval mode, e.g. default | plan | acceptEdits | bypassPermissions (Claude Code), yolo (Gemini CLI), full-auto (Codex CLI)",
          "title": "Permission Mode"
        },
        "interactive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "False when started without a human at a terminal (-p, no TTY, CI)",
          "title": "Interactive"
        },
        "parent_process": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Executable that launched the agent, e.g. zsh, node, python",
          "title": "Parent Process"
        }
      },
      "title": "SessionStart",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "The sensor/adapter that emitted the event.",
      "properties": {
        "sensor": {
          "$ref": "#/$defs/SensorType"
        },
        "sensor_version": {
          "default": "0.1.0",
          "title": "Sensor Version",
          "type": "string"
        },
        "seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-sensor monotonic sequence number",
          "title": "Seq"
        }
      },
      "required": [
        "sensor"
      ],
      "title": "Source",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "Emitted *before* a tool executes. Sensors that can block (hooks, proxies) wait for the\nlocal policy verdict on this event.",
      "properties": {
        "kind": {
          "const": "tool.call",
          "default": "tool.call",
          "title": "Kind",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ToolProvider",
          "default": {
            "kind": "unknown",
            "plugin_id": null,
            "mcp_server": null,
            "mcp_server_url": null
          }
        },
        "arguments": {
          "additionalProperties": true,
          "description": "Redacted by the sensor",
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "tool"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolDescriptor": {
      "additionalProperties": false,
      "description": "A tool as advertised to the model (used for inventory / tool-poisoning checks).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ToolProvider",
          "default": {
            "kind": "unknown",
            "plugin_id": null,
            "mcp_server": null,
            "mcp_server_url": null
          }
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "description_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Sha256"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolDescriptor",
      "type": "object"
    },
    "ToolProvider": {
      "additionalProperties": false,
      "properties": {
        "kind": {
