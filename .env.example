# Copy to .env (git-ignored) before `docker compose up`.
SGA_ADMIN_TOKEN=change-me
# Host port for the API (change if 8000 is taken)
SGA_PORT=8000
# SGA-Dashboard login (read-only: GET /v1/admin only). Open http://localhost:$SGA_PORT/dashboard/
# SGA_DASHBOARD_TOKEN=          # e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Team gateway (docker compose --profile team, docs/team-gateway.md)
# OPENCLAW_TEAM_PASSWORD=      # gateway password for same-host services (the sensor)
# SGA_TEAM_ENROLL_TOKEN=       # one-time enrollment token for the gateway's sensor
# SGA_AUDIT_ENROLL_TOKEN=      # one-time enrollment token for the audit proxy
# SGA_EGRESS_ENROLL_TOKEN=     # one-time enrollment token for the egress proxy
# SGA_EGRESS_MODE=monitor      # monitor (record) | enforce (refuse what the policy blocks)

# Shadow AI demo (docker compose --profile shadow, docs/sensor.md): carol's personal OpenClaw
# SGA_PC_ENROLL_TOKEN=         # one-time enrollment token for carol-pc's sensor
