// Team gateway settings, applied once on first start (`openclaw config patch`).
// People sign in through the team-proxy, which stamps their identity in x-forwarded-user
// (stand-in for Cloudflare Access / an SSO proxy). Same-host services (the SG-Advance sensor)
// use the gateway password from OPENCLAW_GATEWAY_PASSWORD instead.
{
  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    // team-proxy (HTTP) and team-audit (WebSockets, after team-proxy) on compose network team-net
    trustedProxies: ["172.28.0.10", "172.28.0.11"],
    auth: {
      mode: "trusted-proxy",
      trustedProxy: {
        userHeader: "x-forwarded-user",
        requiredHeaders: ["x-forwarded-proto"],
        allowUsers: ["alice@corp.test", "bob@corp.test", "carol@corp.test", "secops@corp.test"],
        deviceAutoApprove: {
          enabled: true,
          scopes: ["operator.read", "operator.write", "operator.approvals", "operator.questions"],
        },
      },
      identityScopes: {
        "secops@corp.test": ["operator.admin"],
      },
    },
    controlUi: {
      // One port per demo employee: different origins keep their browser state apart.
      allowedOrigins: [
        "http://localhost:18801",
        "http://localhost:18802",
        "http://localhost:18803",
        "http://localhost:18804",
      ],
    },
    roles: {
      default: "member",
      definitions: {
        member: {
          sessions: { others: "none" }, // least privilege: share a session explicitly when people need it
          agents: "*",
          scopes: ["operator.read", "operator.write", "operator.approvals", "operator.questions"],
        },
        // Security team: sees every session and every pending approval (operator.admin), so it can
        // review, approve on someone's behalf, or stop a run. Assigned per person with set-role.py.
        security: {
          sessions: { others: "view" },
          agents: "*",
          scopes: ["operator.read", "operator.write", "operator.approvals", "operator.questions", "operator.admin"],
        },
      },
    },
  },
  plugins: {
    load: { paths: ["/opt/sga/plugin"] },
    entries: {
      "sg-advance": {
        enabled: true,
        config: {
          sensorHome: "/home/node/.sg-advance",
          sensorCli: "/opt/sga/venv/bin/sga-sensor",
        },
      },
    },
  },
  // Egress (M5d): the gateway has no direct route out; web_fetch goes through team-egress, which
  // enforces the outbound policy (so letting the proxy resolve DNS is safe).
  tools: { web: { fetch: { useTrustedEnvProxy: true } } },
  // Company baseline (M5d): every model pinned to a runtime the plugin is verified with.
  agents: {
    defaults: {
      models: {
        "openai/gpt-6-luna": { agentRuntime: { id: "openclaw" } },
        "openai/gpt-6-astra": { agentRuntime: { id: "openclaw" } },
      },
    },
  },
}
