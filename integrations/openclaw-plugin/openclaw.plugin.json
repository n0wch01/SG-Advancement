{
  "id": "agent-sentinel",
  "name": "Agent Sentinel",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sensorHome": { "type": "string", "description": "Sensor state dir (default $SENTINEL_HOME or ~/.agent-sentinel)" },
      "socketPath": { "type": "string", "description": "Daemon socket (default <sensorHome>/sentinel.sock)" },
      "sensorCli": { "type": "string", "description": "Path to sentinel-sensor for the degraded path" },
      "readOnlyTools": { "type": "array", "items": { "type": "string" } },
      "daemonTimeoutMs": { "type": "integer", "minimum": 100 },
      "cliTimeoutMs": { "type": "integer", "minimum": 500 },
      "approvalTimeoutMs": { "type": "integer", "minimum": 1000 }
    }
  }
}
