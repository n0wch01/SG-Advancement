{
  "id": "sg-advance",
  "name": "SG-Advance",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sensorHome": { "type": "string", "description": "Sensor state dir (default $SGA_HOME or ~/.sg-advance)" },
      "socketPath": { "type": "string", "description": "Daemon socket (default <sensorHome>/sga.sock)" },
      "sensorCli": { "type": "string", "description": "Path to sga-sensor for the degraded path" },
      "readOnlyTools": { "type": "array", "items": { "type": "string" } },
      "daemonTimeoutMs": { "type": "integer", "minimum": 100 },
      "cliTimeoutMs": { "type": "integer", "minimum": 500 },
      "approvalTimeoutMs": { "type": "integer", "minimum": 1000 },
      "securityWaitMs": { "type": "integer", "minimum": 1000, "description": "How long a call held for security approval waits before it is denied (default 300000)" }
    }
  }
}
